{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "bun"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "electron.vite.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "src/**/*.ts"
  ]
}
