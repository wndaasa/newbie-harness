# 저장소 루트에 .env로 복사해 쓴다. 쓸 줄만 주석을 풀고 값을 넣는다.
# .env 값은 설정창에 저장한 값보다 우선하므로 쓰지 않는 줄은 주석으로 둔다.

# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-proj-your-key-here
# TAVILY_API_KEY=your-key-here

# 제공자: anthropic | openai | ollama | lmstudio | llamacpp | vllm (미설정 시 기본값: openai)
# NEWBIE_PROVIDER=ollama

# 선택: 모델 기본값 덮어쓰기
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.5
# 선택: OpenAI 추론 모델(gpt-5, o1, o3 계열)의 기본 추론 강도 (none | minimal | low | medium | high | xhigh, 기본값: medium)
# OPENAI_REASONING_EFFORT=medium
# 선택: OpenAI 컨텍스트 창 크기(토큰). OpenAI는 창 크기를 알려주는 API가 없어 모델별 표를 쓰는데, 표에 없는 새 모델이나 호환 서버면 여기에 적습니다
# OPENAI_CONTEXT_WINDOW=400000
# OLLAMA_MODEL=gemma4:e4b
# LM_STUDIO_MODEL=your-model-name-here
# llama-server의 --alias 값 (리포 루트 run_model.sh 참고)
# LLAMACPP_MODEL=qwen3-8b

# 로컬 서버 주소
# OLLAMA_HOST=http://localhost:11434
# LM_STUDIO_BASE_URL=http://localhost:1234
# llama-server 주소. 뒤에 /v1 을 붙이지 말 것 — 코드가 /v1/chat/completions 를 덧붙인다
# LLAMACPP_BASE_URL=http://localhost:8080
# vLLM 주소 (/v1 포함). 모델은 --served-model-name 값, 키는 --api-key로 띄웠을 때만
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=your-model-name-here
# VLLM_API_KEY=

# 선택: 응답 출력 상한 (기본값: 32768). 너무 낮추면 긴 파일 쓰기가 중간에 잘린다
# NEWBIE_MAX_TOKENS=32768

# 선택: 1로 설정하면 켜짐
# NEWBIE_MOCK=1                # API 키 없이 mock 응답으로 UI 확인
# NEWBIE_NO_MEMORY=1           # 메모리 주입과 앱 시작 시 자동 정리 끔
# NEWBIE_DISABLE_LOGGING=1     # 대화 로그 기록 비활성화
# NEWBIE_DISABLE_NEWBIE_MD=1   # Newbie.md 지침 주입 비활성화

# 선택: 앱 데이터 저장 위치 (API 키, 세션, MCP 설정, 메모리, OCR 데이터)
# NEWBIE_HOME=C:\Users\your-name\.newbie
